<v:GlassWindow x:Class="Vela.Views.DockWindow"
               xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
               xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
               xmlns:v="clr-namespace:Vela.Views"
               Title="Vela Dock" Topmost="True" ShowActivated="False">
    <Grid x:Name="Root">
        <!-- BarHost carries the edge alignment, margins and the S/M/L scale.
             Shadow: a blurred rounded rect under the bar (static, so it is rendered once).
             Bar layers, bottom to top: Bar.Background (blurred wallpaper slice, glass styles only),
             Tint (style colour), Sheen (rim light), the item row. The bar is clipped to its rounded
             shape with an anti-aliased geometry (GlassWindow.UpdateRegion). -->
        <!-- Auto-hide: a nearly invisible strip on the screen edge that brings the dock back when touched. -->
        <Border x:Name="EdgeTrigger" Height="3" VerticalAlignment="Bottom" Background="#01000000" Visibility="Collapsed" />
        <Grid x:Name="BarHost" HorizontalAlignment="Stretch" VerticalAlignment="Bottom">
            <Border x:Name="Shadow" CornerRadius="16" IsHitTestVisible="False" Background="#66000000" Margin="1,1,1,-1">
                <Border.Effect>
                    <BlurEffect Radius="9" KernelType="Gaussian" RenderingBias="Performance" />
                </Border.Effect>
            </Border>
            <Border x:Name="Bar" CornerRadius="16" Padding="3"
                    BorderThickness="{DynamicResource Hairline}"
                    BorderBrush="{DynamicResource Bar.Border}">
                <Grid>
                    <!-- Liquid Glass: the wallpaper under the bar, refracted on the GPU (LiquidGlassEffect). -->
                    <Border x:Name="Lens" CornerRadius="16" Margin="-3" IsHitTestVisible="False" Visibility="Collapsed">
                        <Grid ClipToBounds="True"><Canvas x:Name="LensWindows" /></Grid>
                    </Border>
                    <Border x:Name="Tint" CornerRadius="16" Margin="-3"
                            Background="{DynamicResource Bar.Background}" />
                    <Border x:Name="Shade" CornerRadius="16" Margin="-3" IsHitTestVisible="False"
                            Background="{DynamicResource Bar.Shade}" />
                    <Border x:Name="Sheen" CornerRadius="16" Margin="-3" IsHitTestVisible="False"
                            Background="{DynamicResource Bar.Sheen}" />
                    <!-- Liquid Glass: a specular rim just inside the edge. -->
                    <Border x:Name="Rim" CornerRadius="16" Margin="-3" IsHitTestVisible="False" BorderThickness="1.2"
                            BorderBrush="{DynamicResource Bar.Rim}" />
                    <DockPanel LastChildFill="True">
                        <!-- Far-right corner, like the Windows taskbar: hover = peek at the desktop, click = show desktop. -->
                        <Border x:Name="DesktopCorner" DockPanel.Dock="Right" Width="9" Margin="4,-3,-3,-3"
                                Background="Transparent" Cursor="Hand" ToolTip="Show desktop">
                            <Border Width="1" Height="20" HorizontalAlignment="Left" Background="{DynamicResource Divider}" />
                        </Border>
                        <v:DockRow x:Name="Items" VerticalAlignment="Center" />
                    </DockPanel>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</v:GlassWindow>
