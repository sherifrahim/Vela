<v:GlassWindow x:Class="Vela.Views.DockWindow"
               xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
               xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
               xmlns:v="clr-namespace:Vela.Views"
               Title="Vela Dock" Topmost="True" ShowActivated="False">
    <Grid x:Name="Root">
        <!-- The bar. The window's region is clipped to this element (see GlassWindow.UpdateRegion).
             Layers, bottom to top: Bar.Background (blurred wallpaper slice, glass styles only),
             Tint (style colour), Sheen (rim light), widgets. -->
        <Border x:Name="Bar"
                HorizontalAlignment="Center" VerticalAlignment="Bottom"
                CornerRadius="20" BorderThickness="1" Padding="5"
                BorderBrush="{DynamicResource Bar.Border}">
            <Grid>
                <Border x:Name="Tint" CornerRadius="19" Margin="-5"
                        Background="{DynamicResource Bar.Background}" />
                <Border x:Name="Sheen" CornerRadius="19" Margin="-5" IsHitTestVisible="False"
                        Background="{DynamicResource Bar.Sheen}" />
                <StackPanel x:Name="Items" Orientation="Horizontal" VerticalAlignment="Center" />
            </Grid>
        </Border>
    </Grid>
</v:GlassWindow>
